# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
# Option 1 (Recommended for Production/CI/CD): Set Firebase credentials as JSON string
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project",...}'

# Option 2 (Recommended for Local Development): Set path to credentials file
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Note: Only one of the above is needed. FIREBASE_CREDENTIALS_JSON takes precedence.

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Settings
API_VERSION=v1
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Google Drive Folder ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Drive OAuth 2.0 (For personal drive upload)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here