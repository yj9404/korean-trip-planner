rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: group_members uses auto-generated doc IDs, so we cannot use
    // exists(uid_groupId) pattern. Access control is enforced by the backend.
    // Frontend Firestore access is granted to authenticated users only.

    // User preferences: Users can read and write their own preferences
    match /user_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups: authenticated users can read; backend controls membership logic
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Group Members: authenticated users can read/create; backend enforces ownership
    match /group_members/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Chat rooms: any authenticated user can read/write
    // (backend already verifies group membership before creating rooms)
    match /chat_rooms/{roomId} {
      allow read, write: if request.auth != null;

      // Messages: any authenticated user can subscribe & send
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Places: user-scoped (legacy / fallback when no group context)
    match /places/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Group Places: shared itinerary visible to all authenticated group members.
    // Group membership enforcement is handled by the backend.
    match /group_places/{groupId} {
      allow read, write: if request.auth != null;

      match /items/{placeId} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
